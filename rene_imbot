-- UNIVERSAL LUARMOR DUMPER SCRIPT
-- Works on all executors (no hookfunction required)

local folderName = "luarmor_dumps"
pcall(makefolder, folderName)

local dumpCounter = 0

-- Hook loadstring by overriding the global variable
local oldLoadstring
oldLoadstring = loadstring

loadstring = function(source, chunkname)
    dumpCounter = dumpCounter + 1
    local filename = folderName .. "/loadstring_dump_" .. tostring(dumpCounter) .. ".lua"
    
    -- Attempt to write file, fallback to console printing if writefile fails
    local success, err = pcall(function()
        writefile(filename, source)
    end)
    
    if success then
        print("[Dumper] Saved loadstring chunk to " .. filename)
    else
        warn("[Dumper] Failed to save file: " .. tostring(err))
        print("[Dumper] Preview (first 500 chars):\n" .. string.sub(source, 1, 500))
    end
    
    return oldLoadstring(source, chunkname)
end

print("[Dumper] Hooked loadstring successfully! Now run your Luarmor loader.")
