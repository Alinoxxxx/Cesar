-- LUARMOR DUMPER SCRIPT
-- Execute this FIRST in your executor, then execute the Luarmor loader script.

local folderName = "luarmor_dumps"
pcall(makefolder, folderName)

local dumpCounter = 0

-- Hook game:HttpGet to capture raw network payloads
local oldHttpGet
oldHttpGet = hookfunction(game.HttpGet, function(self, url, ...)
    local response = oldHttpGet(self, url, ...)
    dumpCounter = dumpCounter + 1
    
    local cleanUrl = url:gsub("[^%w%.%-]", "_"):sub(1, 60)
    local filename = folderName .. "/http_dump_" .. tostring(dumpCounter) .. "_" .. cleanUrl .. ".lua"
    
    writefile(filename, response)
    print("[Dumper] Saved HTTP response from: " .. url .. " to " .. filename)
    return response
end)

-- Hook loadstring to capture scripts compiled on-the-fly
local oldLoadstring
oldLoadstring = hookfunction(loadstring, function(source, chunkname)
    dumpCounter = dumpCounter + 1
    local filename = folderName .. "/loadstring_dump_" .. tostring(dumpCounter) .. ".lua"
    
    writefile(filename, source)
    print("[Dumper] Intercepted compiled loadstring chunk! Saved to " .. filename)
    return oldLoadstring(source, chunkname)
end)

print("[Dumper] Hooked successfully! Now run your Luarmor loader script.")
